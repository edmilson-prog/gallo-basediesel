# =============================================================================
# GALLO BASE DIESEL — environment variables
# =============================================================================
#
# Copy this file to `.env` (or `.env.local` for local overrides) and adjust.
# Vite only exposes variables prefixed with `VITE_` to the client bundle.
#

# -----------------------------------------------------------------------------
# Data Provider (PRD-005)
# -----------------------------------------------------------------------------
# Selects which provider implementation `getDataProviders()` returns.
#
#   mock      → delegates every call to `src/mocks/api/*` (Fase 1, default)
#   supabase  → delegates to Supabase (Fase 2, PRDs 100+); methods that are
#               not yet implemented throw `NotImplementedError`.
#
# Switch is read at build time. Invalid values fall back to `mock` with a
# console warning in dev mode.
VITE_DATA_SOURCE=mock
