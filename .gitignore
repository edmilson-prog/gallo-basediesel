# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# Supabase CLI local state
supabase/.temp
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Vercel
.vercel/

# Generated asset — copied from CHANGELOG.md at dev/build time (see scripts/copy-changelog.mjs)
public/CHANGELOG.md

# Superpowers brainstorming companion (visual mockups, transient sessions)
.superpowers/

# graphify knowledge graph — regenerated locally by the post-commit/post-checkout
# git hooks (graphify hook install) and by `graphify update .`. graph.json alone
# is 20MB+ and churns on every commit; keep it out of history, not in it.
graphify-out/

# Large source assets (kept out of git; use Git LFS if you need to version them)
docs/images/*.pdf
docs/images/*.mp4
docs/images/*.zip
docs/images/favicon_io/

# Development screenshots dropped directly in docs/images (not part of the codebase).
# Non-recursive on purpose: brand assets under docs/images/logos/ stay versioned.
docs/images/*.png
docs/images/*.jpg
docs/images/*.jpeg
docs/images/*.gif
docs/images/*.webp

# Customer PII / raw data dumps — must never reach the remote (LGPD).
# These stay local-only; the database itself is also far over GitHub's 100MB limit.
docs/db/*.FDB
docs/export/
docs/contatos-*.txt
docs/prds/Termo_Consentimento_*.pdf

# Python bytecode from the docs/database introspection tooling.
docs/**/__pycache__/

# Reference copy of the external "sigpro" project — not part of this repo's history.
docs/sigpro/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
